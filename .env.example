# Скопируй в .env и заполни. Этот файл подхватывается автоматически.

# Токены ботов от @BotFather (вида 1234567890:AAH...)
SHOP_BOT_TOKEN=
SECOND_BOT_TOKEN=
MY_OWN_BOT_TOKEN=

# Токен приложения Crypto Pay (@CryptoBot → Crypto Pay → Create App)
CRYPTOBOT_TOKEN=

# Ключи HTTP API Platesh. Сгенерировать надёжный: python -m platesh genkey
# Главный ключ — держи только на сервере Platesh.
PLATESH_API_KEY=
# Ключ бота со своим кодом — его можно положить в код этого бота.
MY_OWN_BOT_API_KEY=
# Секрет для подписи уведомлений на notify_url
PLATESH_WEBHOOK_SECRET=
